# Copy to .env and adjust. All values below are the defaults; the app runs with none set.

# Database. Default is a local SQLite file. For cloud deploy, point this at Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/bioterm
DATABASE_URL=sqlite:///data/bioterm.db

# SEC EDGAR requires a User-Agent identifying you (name + email). Be a good citizen.
BIOTERM_SEC_USER_AGENT=BioTerm/0.1 (nishantthalwal@gmail.com)

# Optional: cap the working universe for quick runs (0 = no cap).
BIOTERM_UNIVERSE_LIMIT=0

# HTTP politeness
BIOTERM_HTTP_TIMEOUT=20
