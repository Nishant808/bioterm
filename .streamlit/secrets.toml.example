# Copy to .streamlit/secrets.toml for LOCAL testing against the cloud Postgres,
# OR paste these keys into the Streamlit Community Cloud app's "Secrets" box.
# (.streamlit/secrets.toml is gitignored.)

DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require"
BIOTERM_SEC_USER_AGENT = "BioTerm/0.1 (you@example.com)"
